{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kompass",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-01",
  "observability": {
    "enabled": true,
  },
  "vars": {
    // Deliberately EMPTY in the repo.
    //
    // These power the optional Cloudflare-utilisation panel on /status
    // (src/worker/cf-usage.ts), which is best-effort and returns null without
    // them. Unlike bindings, plain vars are NOT rewritten by the
    // Deploy-to-Cloudflare provisioning step — so a real value here would ship
    // the repo owner's account id to every install and point their usage panel
    // at someone else's account.
    //
    // To enable the panel on your own deployment, set them as Worker secrets
    // (Settings → Variables and Secrets), which override these at runtime:
    //   CLOUDFLARE_ACCOUNT_ID, CLOUDFLARE_KV_NAMESPACE_ID, CLOUDFLARE_API_TOKEN
    "CLOUDFLARE_ACCOUNT_ID": "",
    "CLOUDFLARE_KV_NAMESPACE_ID": "",
  },
  // Workers AI binding. A binding needs NO API key: it authenticates as the
  // account the Worker is deployed to (verified live 2026-07-25 —
  // @cf/meta/llama-3.3-70b-instruct-fp8-fast answered with no CF_WORKERS_AI_KEY
  // present). This is what lets a freshly deployed Kompass answer chat with
  // zero provider signups.
  //
  // Deliberately absent from wrangler.test.jsonc: AI bindings have no local
  // Miniflare implementation, so vitest-pool-workers would try to open a remote
  // proxy session and fail without an authenticated wrangler.
  "ai": {
    "binding": "AI",
  },
  "kv_namespaces": [
    {
      "binding": "CONFIG",
      // Placeholder. Cloudflare provisions a fresh namespace during a
      // Deploy-to-Cloudflare install and rewrites this id, per
      // developers.cloudflare.com/workers/platform/deploy-buttons/. A local
      // `wrangler deploy` needs a real id here — `kompass init` writes one.
      "id": "ac8f63619364493897213cd0d58feefd",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "KOMPASS_STATE",
        "class_name": "KompassState",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["KompassState"],
    },
  ],
  "triggers": {
    // Daily model-discovery run (src/worker/discovery.ts) — detect-only, never
    // mutates config. 06:00 UTC: cheap (models-list calls, no completion tokens).
    "crons": ["0 6 * * *"],
  },
}
